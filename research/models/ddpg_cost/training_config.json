{
  "algo": "ddpg",
  "reward_mode": "lagrangian",
  "economy_metric": "cost",
  "run_name": "ddpg_cost",
  "seed": 42,
  "timesteps": 1000000,
  "n_envs": 2,
  "lr": 0.001,
  "buffer_size": 200000,
  "batch_size": 256,
  "learning_starts": 10000,
  "action_noise_sigma": 0.2,
  "eta_util": 5.0,
  "eta_class": 5.0,
  "eta_geom": 2.0,
  "lambda_max": 200.0,
  "lagrangian_update_freq": 2048,
  "out_dir": "./research/models"
}